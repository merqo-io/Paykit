NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Shared-session SSO across *.merqo.io kits — leave unset in dev/preview
# (they don't run on merqo.io; setting this there breaks login instead of
# just failing to share it). Set to .merqo.io in Vercel Production, and on
# Preview for Git branch `staging` only (its *-staging.merqo.io host).
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
# MERQO_METRICS_SECRET and MERQO_PROVISION_SECRET must be two DIFFERENT secret values — a leak of one must not grant the other's capability.
MERQO_METRICS_SECRET=
MERQO_PROVISION_SECRET=
# New: paykit's first kit -> merqo outbound HTTP call (every var above gates
# the opposite, inbound direction — merqo calling paykit). Used by
# src/lib/legal-gate.ts and src/app/legal/accept/actions.ts to check/record a
# vendor's terms/privacy acceptance with merqo. MERQO_CUSTOMER_SECRET is sent
# as `Authorization: Bearer <value>` and must equal the value merqo's own
# MERQO_CUSTOMER_SECRET env var records (same shared secret qkit/loopkit use
# for this direction). Server-only; unset here fails the legal gate CLOSED —
# every signed-in vendor gets bounced to /legal/accept and the accept action
# throws — so set both for any environment where vendors sign in.
MERQO_BASE_URL=
MERQO_CUSTOMER_SECRET=
# Payment provider selector — "direct" (default) wraps the existing EMVCo/pointer builder unchanged. Unset or unrecognized falls back to "direct" with a warning; never leave a stray value that doesn't match a registered provider.
PAYKIT_PROVIDER=
# Server-side error tracking (src/instrumentation.ts). Leave unset in dev/preview — the SDK no-ops with no dsn, this never blocks anything.
SENTRY_DSN=
